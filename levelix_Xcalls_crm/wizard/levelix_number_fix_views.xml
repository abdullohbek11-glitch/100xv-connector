<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_levelix_number_fix_form" model="ir.ui.view">
        <field name="name">levelix.number.fix.form</field>
        <field name="model">levelix.number.fix</field>
        <field name="arch" type="xml">
            <form string="Normalize Phone Numbers">
                <p>
                    Reformat existing <b>phone</b> / <b>mobile</b> numbers to the E.164
                    format (e.g. <code>+998901112233</code>) so incoming calls match reliably.
                    Run <b>Preview</b> first.
                </p>
                <group>
                    <field name="fix_partners"/>
                    <field name="fix_leads"/>
                    <field name="country_id"/>
                </group>
                <field name="result" readonly="1" widget="text"
                       invisible="not result" nolabel="1"/>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary" confirm="Reformat the numbers now?"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_levelix_number_fix" model="ir.actions.act_window">
        <field name="name">Normalize Phone Numbers</field>
        <field name="res_model">levelix.number.fix</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
