<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_levelix_event_list" model="ir.ui.view">
        <field name="name">levelix.calls.event.list</field>
        <field name="model">levelix.calls.event</field>
        <field name="arch" type="xml">
            <list string="XCall Events" create="false" edit="false">
                <field name="received_at"/>
                <field name="event_type"/>
                <field name="call_uid"/>
                <field name="event_uid" optional="hide"/>
                <field name="signature_ok" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'"
                       decoration-success="state == 'processed'"
                       decoration-muted="state == 'ignored'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_levelix_event_form" model="ir.ui.view">
        <field name="name">levelix.calls.event.form</field>
        <field name="model">levelix.calls.event</field>
        <field name="arch" type="xml">
            <form string="XCall Event" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="call_uid"/>
                            <field name="event_uid"/>
                            <field name="received_at"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="signature_ok"/>
                            <field name="config_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Payload"/>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_levelix_event" model="ir.actions.act_window">
        <field name="name">Events Log</field>
        <field name="res_model">levelix.calls.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
