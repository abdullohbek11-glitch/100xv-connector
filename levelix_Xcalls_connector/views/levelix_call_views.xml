<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_levelix_call_list" model="ir.ui.view">
        <field name="name">levelix.calls.call.list</field>
        <field name="model">levelix.calls.call</field>
        <field name="arch" type="xml">
            <list string="Calls" create="false">
                <field name="start_time"/>
                <field name="direction"/>
                <field name="number_e164"/>
                <field name="contact_name" optional="show"/>
                <field name="duration"/>
                <field name="status"/>
                <field name="recording" widget="boolean" string="Rec" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_levelix_call_form" model="ir.ui.view">
        <field name="name">levelix.calls.call.form</field>
        <field name="model">levelix.calls.call</field>
        <field name="arch" type="xml">
            <form string="Call" create="false">
                <sheet>
                    <group>
                        <group string="Call">
                            <field name="direction"/>
                            <field name="number"/>
                            <field name="number_e164"/>
                            <field name="contact_name"/>
                            <field name="status"/>
                        </group>
                        <group string="Timing">
                            <field name="start_time"/>
                            <field name="answer_time"/>
                            <field name="end_time"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <separator string="Recording"/>
                    <group>
                        <group>
                            <field name="recording_format"/>
                            <field name="recording" filename="recording_filename"/>
                            <field name="recording_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="recording_player" nolabel="1"
                           invisible="not recording and not recording_url"/>
                    <group string="Technical" col="4">
                        <field name="call_uid"/>
                        <field name="backend_user_id"/>
                        <field name="backend_device_id"/>
                        <field name="config_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_levelix_call_search" model="ir.ui.view">
        <field name="name">levelix.calls.call.search</field>
        <field name="model">levelix.calls.call</field>
        <field name="arch" type="xml">
            <search string="Calls">
                <field name="number_e164"/>
                <field name="number"/>
                <field name="contact_name"/>
                <field name="call_uid"/>
                <filter name="incoming" string="Incoming" domain="[('direction','=','incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction','=','outgoing')]"/>
                <separator/>
                <filter name="has_rec" string="With recording" domain="[('recording','!=',False)]"/>
                <group>
                    <filter name="g_direction" string="Direction" context="{'group_by':'direction'}"/>
                    <filter name="g_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_levelix_call" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">levelix.calls.call</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_levelix_call_search"/>
    </record>

</odoo>
